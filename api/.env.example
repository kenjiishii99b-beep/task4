# uvicorn で直接起動するときに読み込まれる設定（func start のときは local.settings.json が使われる）

# 未設定なら SQLite（api/local.db）で動く。MySQL を使う場合:
# DATABASE_URL=mysql+pymysql://app:app_password@127.0.0.1:3306/person_map
# Azure Database for MySQL の場合（SSL 必須）:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<server>.mysql.database.azure.com:3306/person_map
# MYSQL_SSL=true
DATABASE_URL=sqlite:///./local.db
MYSQL_SSL=false

# AI の接続先。Azure OpenAI の 3 項目がそろっていれば Azure を優先し、
# なければ OPENAI_API_KEY の OpenAI、どちらもなければ簡易抽出（モック）で動作する。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# 空なら v1 API。従来の api-version 付き URL を使う場合だけ指定（例: 2024-10-21）
AZURE_OPENAI_API_VERSION=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# カンマ区切り。SWA の URL を本番で追加する
CORS_ORIGINS=http://localhost:3000
